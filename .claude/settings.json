{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/fixtures/golden/**)",
      "Edit(/.githooks/**)",
      "Bash(git *--no-verify*)",
      "Bash(git *commit *-n)",
      "Bash(git *commit *-n *)",
      "Bash(git *commit *-nm*)",
      "Bash(git *commit *-an*)",
      "Bash(git -c *)",
      "Bash(git config *core.hooksPath*)"
    ]
  }
}
